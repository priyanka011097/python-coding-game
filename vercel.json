{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__path=/api/:path*" },
    { "source": "/auth/:path*", "destination": "/api/handler?__path=/auth/:path*" }
  ],
  "functions": {
    "api/handler.ts": { "maxDuration": 60 }
  }
}
