# Copy this file to .env.local or .env (both git-ignored) and fill in your key.
# One line, no spaces: NVIDIA_API_KEY=nvapi-...
# Get one at https://build.nvidia.com — pick a model, then "Get API Key".
NVIDIA_API_KEY=nvapi-your-key-here

# Optional. Any chat model from build.nvidia.com.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
