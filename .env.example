# Copy this file to .env.local or .env (both git-ignored) and fill in your key.
# One line, no spaces: NVIDIA_API_KEY=nvapi-...
# Get one at https://build.nvidia.com — pick a model, then "Get API Key".
NVIDIA_API_KEY=nvapi-your-key-here

# Optional. Any chat model from build.nvidia.com.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional. "on" lets reasoning models think before answering: slower, and
# on hard questions it can use up the whole reply budget. Off by default.
# NVIDIA_THINKING=on

# ---------- Google sign-in (sign up / log in / log out) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> "Web application". Under "Authorized redirect URIs"
# add exactly: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Any long random string; keeps people signed in across server restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Optional. The site's public address, used for Google sign-in and, at build
# time, for canonical links, the sitemap and share images. Set it in Vercel
# when you move to your own domain, e.g. APP_URL=https://prep.buildwithpriyanka.in
# APP_URL=http://localhost:5173

# ---------- MongoDB (accounts + progress that follows your Google account) ----------
# Atlas -> your cluster -> Connect -> Drivers -> copy the connection string.
# Also: Atlas -> Network Access -> add this computer's IP address.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Optional. Database name if the URI does not include one.
# MONGODB_DB=interview_prep

# ---------- Admin page ----------
# Google emails (comma-separated) that can open the Admin page and see every
# user and their progress.
ADMIN_EMAILS=you@gmail.com

# ---------- Search engines ----------
# Optional. Google Search Console -> Add property -> URL prefix -> "HTML tag":
# paste only the content="..." value here (and in Vercel), then redeploy.
# GOOGLE_SITE_VERIFICATION=abc123

# Optional. Google Analytics 4: analytics.google.com -> Admin -> Data streams
# -> Web -> your site -> "Measurement ID" (starts with G-). Set it in Vercel
# and redeploy. Not used in local development.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------- Google AdSense ----------
# Optional. adsense.google.com -> your publisher ID (ca-pub-...). Adds the
# AdSense code to every page and creates /ads.txt. Set in Vercel, redeploy.
# ADSENSE_CLIENT=ca-pub-1234567890123456
# After approval, optional: AdSense -> Ads -> By ad unit -> Display ads,
# one vertical unit per side. Put each unit's data-ad-slot number here.
# ADSENSE_SLOT_LEFT=1234567890
# ADSENSE_SLOT_RIGHT=1234567890
